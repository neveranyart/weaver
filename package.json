{
  "author": "neveranyart",
  "name": "@neveranyart/weaver",
  "repository": {
    "url": "git+https://github.com/neveranyart/weaver.git"
  },
  "license": "LGPL-2.1-or-later",
  "version": "0.0.1",
  "description": "A collection of React CSR components, hooks for handling many moving part of a creative web with ease. ",
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "tsup": {
    "entry": {
      "index": "src/index.ts",
      "routing": "src/routing/index.ts",
      "scene": "src/scene/index.ts",
      "hooks": "src/hooks/index.ts"
    },
    "format": [
      "cjs",
      "esm"
    ],
    "dts": true,
    "splitting": false,
    "sourcemap": true,
    "clean": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "lenis": "^1.3.23",
    "react": "^19.2.7",
    "react-router": "^8.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "@react-three/drei": ">=10.0.0",
    "@react-three/fiber": ">=9.0.0",
    "lenis": ">=1.1.16",
    "react": ">=19.1.0",
    "react-router": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "lenis": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "require": "./dist/hooks.js",
      "import": "./dist/hooks.mjs",
      "default": "./dist/hooks.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "require": "./dist/routing.js",
      "import": "./dist/routing.mjs",
      "default": "./dist/routing.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "require": "./dist/scene.js",
      "import": "./dist/scene.mjs",
      "default": "./dist/scene.js"
    }
  },
  "packageManager": "pnpm@11.8.0"
}
