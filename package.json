{
  "author": "kemolumi",
  "name": "@neveranyart/weaver",
  "keywords": [
    "csr",
    "react",
    "react-router",
    "lenis",
    "three",
    "threejs",
    "react-three-fiber"
  ],
  "repository": {
    "url": "git+https://github.com/neveranyart/weaver.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "type": "module",
  "license": "LGPL-2.1-or-later",
  "version": "1.4.0",
  "description": "A collection of React CSR components, hooks for handling many moving part of a creative web with ease. ",
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "tsup": {
    "entry": {
      "index": "src/index.ts",
      "routing": "src/routing/index.ts",
      "scene": "src/scene/index.ts",
      "hooks": "src/hooks/index.ts"
    },
    "format": [
      "esm"
    ],
    "dts": true,
    "splitting": true,
    "sourcemap": true,
    "clean": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "lenis": "^1.3.27",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-router": "^8.4.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "@react-three/drei": ">=10.0.0",
    "@react-three/fiber": ">=9.0.0",
    "lenis": ">=1.1.16",
    "react": ">=19.1.0",
    "react-router": ">=7.0.0",
    "three": ">=0.170.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "lenis": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "require": "./dist/hooks.js",
      "import": "./dist/hooks.js",
      "default": "./dist/hooks.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "require": "./dist/routing.js",
      "import": "./dist/routing.js",
      "default": "./dist/routing.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "require": "./dist/scene.js",
      "import": "./dist/scene.js",
      "default": "./dist/scene.js"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
