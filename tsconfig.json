{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "module": "commonjs",
    "jsx": "react",
    "outDir": "./dist",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "paths": {
      "@neveranyart/weaver/helper": ["./src/hooks"],
      "@neveranyart/weaver/routing": ["./src/routing"],
      "@neveranyart/weaver/scene": ["./src/scene"],
      "@neveranyart/weaver": ["./src"]
    }
  },
  "include": [
    "src/package",
    "src/hooks",
    "src/routing",
    "src/scene",
    "src/utils",
    "src/routing/context.ts",
    "src/setup.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
